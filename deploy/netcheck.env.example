# /etc/netcheck/netcheck.env - root:root 0600, read by systemd before dropping privileges.
# Never commit the real file.
DOMAIN=example.com
VPS_IP=203.0.113.10
VPS_IPV6=2001:db8::10
# Bind only the public addresses: systemd-resolved already holds 127.0.0.53:53.
DNS_BIND=["203.0.113.10","2001:db8::10"]
# Optional: free key from greynoise.io raises the daily lookup limit.
#GREYNOISE_API_KEY=
