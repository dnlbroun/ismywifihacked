[Unit]
Description=Network Checkup authoritative DNS server (dns.<DOMAIN>)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netcheck-dns
Group=netcheck-dns
EnvironmentFile=/etc/netcheck/netcheck.env
Environment=DATA_DIR=/var/lib/netcheck
WorkingDirectory=/opt/netcheck/app
ExecStart=/opt/netcheck/app/.venv/bin/python -m netcheck.dns
Restart=on-failure
RestartSec=2
StateDirectory=netcheck/dns
StateDirectoryMode=0750
UMask=0027
MemoryMax=200M

# Bind :53 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Sandboxing
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
